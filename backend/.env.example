# Base de données
MONGODB_URI=mongodb://127.0.0.1:27017/auto-documents

# Auth JWT & session
JWT_SECRET=change-me-in-production
SESSION_SECRET=change-me-session-in-production

PORT=3001
NODE_ENV=development

# URL du frontend (CORS + redirections OAuth / Stripe)
FRONTEND_URL=http://localhost:5174

# Google OAuth (optionnel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Stripe (abonnement)
# Clés : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Produit / Prix récurrent : https://dashboard.stripe.com/products — copier l’ID price_...
STRIPE_PRICE_ID=
# Webhook signing secret : https://dashboard.stripe.com/webhooks — endpoint POST https://<votre-api>/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
